{
  "$comment": "Single source of truth for TinBela visual design (ADR-0014). Run `make tokens` to generate the Dart theme, Tailwind config, and CSS variables. Never hardcode a colour in a client.",
  "color": {
    "primary":    { "value": "#1B7A4E", "use": "brand, primary action, positive balance" },
    "accent":     { "value": "#E39312", "use": "secondary action (+বাজার / +জমা)" },
    "alert":      { "value": "#C0392B", "use": "debt, meal-off, cutoff passed" },
    "surface":    { "value": "#FAF6EF", "use": "page background — chosen for SUNLIGHT GLARE, not taste. Do not change to white." },
    "card":       { "value": "#FFFFFF", "use": "card background" },
    "ink":        { "value": "#1A1A1A", "use": "primary text" },
    "inkMuted":   { "value": "#6B6B6B", "use": "secondary text" },
    "tint":       { "value": "#E8F3ED", "use": "light green fill, selected state" },
    "divider":    { "value": "#E8E2D8", "use": "hairlines" }
  },
  "font": {
    "bn": { "family": "Hind Siliguri" },
    "en": { "family": "system" }
  },
  "type": {
    "display":  { "size": 28, "lineHeight": 34, "weight": 600 },
    "title":    { "size": 20, "lineHeight": 26, "weight": 600 },
    "body":     { "size": 16, "lineHeight": 24, "weight": 400 },
    "caption":  { "size": 13, "lineHeight": 18, "weight": 400 },
    "numberLg": { "size": 32, "lineHeight": 38, "weight": 600, "tabular": true }
  },
  "space":  { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },
  "radius": { "card": 16, "button": 12, "chip": 8, "appIcon": 64 },
  "touch":  { "min": 48, "$comment": "dp. Non-negotiable — glare and one-handed use." },
  "shadow": { "one": "0 1px 4px rgba(0,0,0,0.08)", "$comment": "One elevation only. 60fps on a 4-year-old device." }
}
