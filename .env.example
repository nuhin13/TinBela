# Copy to .env — never commit .env

APP_ENV=dev
HTTP_PORT=8080
TZ=Asia/Dhaka

# Postgres — the API connects as tinbela_app, a non-owner, non-superuser
# role, so row-level security actually applies to it (migration 000003).
# Migrations and the seed run as the owner: that DSN lives in .mise.toml
# and the Makefile, not here. Rotate this password in production.
PG_DSN=postgres://tinbela_app:tinbela_app@localhost:5432/tinbela?sslmode=disable

# Firebase (manager auth, ADR-0009).
#
# FIREBASE_PROJECT_ID is the whole configuration for verifying ID tokens:
# verification checks a signature against Google's PUBLIC certificates, and
# the project id is the audience the token must have been minted for. Leave
# it unset and the API refuses to boot outside APP_ENV=dev, rather than
# starting with a verifier that accepts anyone.
FIREBASE_PROJECT_ID=

# Only needed by operations that MINT tokens or read user records. Nothing
# in v1.0 does, so this stays empty until something requires it.
GOOGLE_APPLICATION_CREDENTIALS=

# Invite tokens
INVITE_TOKEN_BYTES=32

# Admin portal
ADMIN_ALLOWED_EMAILS=
