# Copy to .env — never commit .env

APP_ENV=dev
HTTP_PORT=8080
TZ=Asia/Dhaka

# Postgres — the API connects as tinbela_app, a non-owner, non-superuser
# role, so row-level security actually applies to it (migration 000003).
# Migrations and the seed run as the owner: that DSN lives in .mise.toml
# and the Makefile, not here. Rotate this password in production.
PG_DSN=postgres://tinbela_app:tinbela_app@localhost:5432/tinbela?sslmode=disable

# Firebase (manager auth) — service account JSON path, not the JSON itself
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Invite tokens
INVITE_TOKEN_BYTES=32

# Admin portal
ADMIN_ALLOWED_EMAILS=
